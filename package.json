{
  "name": "s3eidat-tools-app",
  "productName": "S3eidat Tools",
  "version": "0.1.0",
  "description": "Every S3eidat Tools tool in one private, offline app.",
  "author": "S3eidat",
  "license": "MIT",
  "homepage": "https://s3eidat.github.io",
  "repository": { "type": "git", "url": "https://github.com/s3eidat/s3eidat-tools-app.git" },
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "build:www": "node scripts/build-www.mjs",
    "test": "node --test test/",
    "start": "electron .",
    "smoke": "node scripts/smoke.mjs",
    "icon": "electron scripts/make-icon.js",
    "dist": "npm run build:www && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "44.10.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.s3eidat.tools",
    "productName": "S3eidat Tools",
    "copyright": "Copyright (c) 2026 S3eidat",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["electron/**", "package.json"],
    "extraResources": [{ "from": "www", "to": "www" }],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "S3eidat-Tools-Windows-Setup.exe",
      "shortcutName": "S3eidat Tools"
    }
  }
}
